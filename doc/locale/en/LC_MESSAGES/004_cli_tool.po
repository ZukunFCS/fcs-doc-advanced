#: ../../004_cli_tool.md:288
msgid "`process` Step"
msgstr ""

#: ../../004_cli_tool.md:290
msgid "Processes a single video file and optionally uploads results to Maya."
msgstr ""

#: ../../004_cli_tool.md:292 ../../004_cli_tool.md:406
msgid "**Format:**"
msgstr ""

#: ../../004_cli_tool.md:315 ../../004_cli_tool.md:412
msgid "**Fields:**"
msgstr ""

#: ../../004_cli_tool.md:317
msgid "**`video`** (required, string): Path to the video file to process"
msgstr ""

#: ../../004_cli_tool.md:318
msgid "**`upload`** (optional, mapping): Upload options to Maya"
msgstr ""

#: ../../004_cli_tool.md:319
msgid "`animation` (bool): Upload animation curves"
msgstr ""

#: ../../004_cli_tool.md:320
msgid "`audio` (bool): Upload audio track"
msgstr ""

#: ../../004_cli_tool.md:321
msgid "`frames` (bool): Upload video frames as image sequence"
msgstr ""

#: ../../004_cli_tool.md:322
msgid ""
"`lm_frames` (bool): Upload landmark-annotated frames. **Not supported "
"with `++` pipelines** (`RP++`, `Rich++`, `Robust++`); raises "
"`LM_FRAMES_UNSUPPORTED_PIPELINE` if used with one."
msgstr ""

#: ../../004_cli_tool.md:323
msgid "**`export`** (optional, mapping): Export options after processing"
msgstr ""

#: ../../004_cli_tool.md:324
msgid "`scene` (bool): Export Maya scene file"
msgstr ""

#: ../../004_cli_tool.md:325
msgid "`playblast` (bool): Export playblast video"
msgstr ""

#: ../../004_cli_tool.md:326
msgid ""
"**`force_reprocess`** (optional, bool): Force reprocessing even if cache "
"exists. Default: `true`"
msgstr ""

#: ../../004_cli_tool.md:327
msgid ""
"**`time_offset_frames`** (optional, integer): Frame offset for animation "
"upload. Default: `0`, must be >= 0."
msgstr ""

#: ../../004_cli_tool.md:328
msgid ""
"**`reopen_maya_scene`** (optional, bool): Controls whether the Maya scene"
" is reopened before processing:"
msgstr ""

#: ../../004_cli_tool.md:329
msgid "`true` — always reopen, regardless of overrides or upload flags"
msgstr ""

#: ../../004_cli_tool.md:330
msgid "`false` — never reopen (explicit opt-out)"
msgstr ""

#: ../../004_cli_tool.md:331
msgid ""
"omitted — **auto**: reopen only when any override (`command_port`, "
"`maya_scene`, or `maya_base`) is present AND at least one `upload.*` flag"
" is `true`"
msgstr ""

#: ../../004_cli_tool.md:332
msgid ""
"Positive values: Animation starts at the `time_offset_frames`th frame on "
"Maya"
msgstr ""

#: ../../004_cli_tool.md:333
msgid "Zero: No offset"
msgstr ""

#: ../../004_cli_tool.md:334
msgid ""
"**`overrides`** (optional, mapping): Override values for this specific "
"process step"
msgstr ""

#: ../../004_cli_tool.md:335
msgid ""
"`command_port` (optional, integer): Maya commandPort number to use for "
"this step. Must be an integer between 1 and 65535. If provided, recreates"
" the connection with the specified port for this step only, overriding "
"the port from `context.command_port` or application settings. A preflight"
" check is performed after to ensure Maya is reachable."
msgstr ""

#: ../../004_cli_tool.md:336
msgid ""
"`maya_scene` (optional, string): Path to Maya scene file to use for this "
"step. Overrides the session's `maya_scene` when `reopen_maya_scene` is "
"`true`."
msgstr ""

#: ../../004_cli_tool.md:337
msgid ""
"`maya_base` (optional, string): Path to Maya workspace base directory to "
"use for this step. Overrides the session's `maya_base` when "
"`reopen_maya_scene` is `true`."
msgstr ""

#: ../../004_cli_tool.md:338
msgid ""
"`out_scene_path` (optional, string): Path to save Maya scene file (must "
"have `.ma` or `.mb` extension). If not provided when `export.scene` is "
"`true`, a warning is logged and the scene is **not saved**."
msgstr ""

#: ../../004_cli_tool.md:339
msgid ""
"`out_playblast_path` (optional, string): Path to save playblast video, "
"**without a file extension** (`.mp4` is appended automatically). If not "
"provided when `export.playblast` is `true`, a default path is derived "
"from the session's output folder and app settings."
msgstr ""

#: ../../004_cli_tool.md:341
msgid ""
"**Note**: The process step always recreates the Affogato connection with "
"the effective port (override or context) and performs a preflight check "
"before processing. When `reopen_maya_scene` is omitted and overrides are "
"present, the scene is reopened automatically (see `reopen_maya_scene` "
"above)."
msgstr ""

