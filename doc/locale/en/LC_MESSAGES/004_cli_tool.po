#: ../../004_cli_tool.md:65
msgid "Every script must have three required sections:"
msgstr ""

#: ../../004_cli_tool.md:75
msgid "Version"
msgstr ""

#: ../../004_cli_tool.md:77
msgid ""
"Currently, only version `1` is supported. This field ensures forward "
"compatibility as the script format evolves."
msgstr ""

#: ../../004_cli_tool.md:79
msgid "Context"
msgstr ""

#: ../../004_cli_tool.md:81
msgid ""
"The `context` section defines the session file to load at the start of "
"script execution."
msgstr ""

#: ../../004_cli_tool.md:83
msgid ""
"**`session`** (required, string): Path to the FCS session YAML file. Must"
" point to a file named exactly `fcs_session.yaml`; any other filename "
"will fail validation."
msgstr ""

#: ../../004_cli_tool.md:84
msgid ""
"**`wait_seconds_after_scene_open`** (optional, float): Global sleep time "
"in seconds to wait after a Maya scene is opened. This applies to all "
"scene opening operations in the script, including when scenes are opened "
"via `reopen_maya_scene` in `process` steps or when Maya launches with a "
"scene. Default: `0.0` (no wait)"
msgstr ""

#: ../../004_cli_tool.md:85
msgid ""
"**`fisheye`** (optional, bool): Enable or disable fisheye correction for "
"video processing. If provided, overrides the UI setting. Default: `true`"
msgstr ""

#: ../../004_cli_tool.md:86
msgid ""
"**`pipeline`** (optional, string): Processing pipeline to use for video "
"processing. Must be one of: `\"Rich\"`, `\"Robust\"`, `\"RP\"`, "
"`\"RP++\"`, `\"Robust++\"`, `\"Rich++\"`. If provided, overrides the UI "
"setting. Default: `\"RP++\"`"
msgstr ""

#: ../../004_cli_tool.md:87
msgid ""
"**`denoising`** (optional, string): Path to a denoising/smoothing profile"
" file, or a filename to load from the smoothing presets directory. If "
"it's a full path, it must exist. If it's just a filename (not a full "
"path), it will be loaded from "
"`FCS_TMP_DIR/smoothing_presets/filename.yaml`. If provided, loads the "
"profile before processing. Default: No Smoothing"
msgstr ""

#: ../../004_cli_tool.md:88
msgid ""
"**`command_port`** (optional, integer): Maya commandPort number to use "
"for all Maya operations in the script. Must be an integer between 1 and "
"65535. If provided, recreates the connection with the specified port and "
"uses it for all Maya preflight checks and uploads. Default: 42069."
msgstr ""

#: ../../004_cli_tool.md:89
msgid ""
"**`initial_scene_open`** (optional, bool): If `true` (the default), "
"automatically opens the Maya scene once after data validation and before "
"running all steps. The scene is opened only once at the start of script "
"execution (after the preflight check), not before each step. If `false`, "
"skips the initial scene opening. Default: `true` (scene will be opened "
"automatically if `maya_scene` and `maya_base` are set in the session)."
msgstr ""

#: ../../004_cli_tool.md:90
msgid ""
"**`rename_controllers`** (optional, mapping): Modify controller names by "
"prepending or removing a prefix. This is applied once after the session "
"is loaded, before any steps execute. Useful for adapting controller names"
" to match Maya scene naming conventions."
msgstr ""

#: ../../004_cli_tool.md:91
msgid ""
"`prefix` (required, string): The prefix to prepend or remove from all "
"controller names"
msgstr ""

#: ../../004_cli_tool.md:92
msgid ""
"`action` (optional, string): Operation to perform - `\"prepend\"` "
"(default) or `\"remove\"`"
msgstr ""

#: ../../004_cli_tool.md:93
msgid ""
"**`playblast`** (optional, mapping): Override playblast settings for all "
"process steps that export playblast. If not set, application settings are"
" used."
msgstr ""

#: ../../004_cli_tool.md:94
msgid "`camera` (optional, string): Maya camera name (e.g. `\"persp\"`)."
msgstr ""

#: ../../004_cli_tool.md:95
msgid "`width` (optional, integer): Output width in pixels."
msgstr ""

#: ../../004_cli_tool.md:96
msgid "`height` (optional, integer): Output height in pixels."
msgstr ""

#: ../../004_cli_tool.md:97
msgid ""
"`percent` (optional, integer): Resolution percent (e.g. 100, must be "
"1–100)."
msgstr ""

#: ../../004_cli_tool.md:98
msgid ""
"`quality` (optional, integer): Playblast quality (e.g. 100, must be "
"1–100)."
msgstr ""

#: ../../004_cli_tool.md:99
msgid ""
"**`profiles`** (optional, list): Rules to enable/disable ROM profiles in "
"the loaded session before any steps run. See [Profiles](#profiles) for "
"full details."
msgstr ""

